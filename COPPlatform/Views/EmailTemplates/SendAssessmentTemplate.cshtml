@model COPPlatform.Views.EmailModels.EmailInvitationSendRequestDto
@{
    Layout = null;

    var isAnalyst = Model.Role == COPPlatform.Models.UserRole.Analyst;
    var isEvaluator = Model.Role == COPPlatform.Models.UserRole.Evaluator;
}

<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background:#F4F6FB;font-family:Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="padding:30px 0;">
        <tr>
            <td align="center">

                <table width="720" cellpadding="0" cellspacing="0"
                       style="background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,0.08);">

                    <!-- HEADER -->
                    <tr>
                        <td align="center" style="background:#63a1ff;padding:40px 30px 25px;">
                            <img src="@($"{Model.ApiUrl}/assets/images/grand-event-readiness-system.png")"
                                 style="height:75px;margin-bottom:20px;" />

                            <div style="font-size:26px;font-weight:600;color:#304a43;">
                                @Model.Title
                            </div>
                        </td>
                    </tr>

                    <!-- CONTENT -->
                    <tr>
                        <td style="padding:35px 40px;font-size:15px;color:#444;line-height:1.7;">

                            <p>Hi @Model.UserName,</p>

                            <p>
                                You have received a new invitation to participate in an assessment on the
                                <strong>Grand Event System</strong> platform.
                            </p>

                            @* ROLE-BASED MESSAGE *@
                            @if (isAnalyst)
                            {
                                <p>
                                    You have been assigned as an <strong>Analyst</strong> for selected pillars in this assessment.
                                    You can begin working on the assigned sections and coordinate with evaluators if required.
                                </p>
                            }

                            @if (isEvaluator)
                            {
                                <p>
                                    You have been invited as an <strong>Evaluator</strong> for selected pillars in this assessment.
                                    You will review submissions and provide evaluation inputs as part of the assessment process.
                                </p>
                            }

                            <p>
                                Click below to access and view the assessment:
                            </p>

                            <!-- CTA BUTTON -->
                            <div style="text-align:center;margin:25px 0;">
                                <a href="@Model.ResetPasswordUrl"
                                   style="display:inline-block;padding:14px 26px;background:#63a1ff;
                                  color:#304a43;text-decoration:none;font-weight:600;
                                  border-radius:8px;font-size:16px;">
                                    View Assessment
                                </a>
                            </div>

                            <!-- RESPONSIBILITIES -->
                            <div style="margin:20px 0;padding:18px;background:#e6eceb;border-left:4px solid #304A43;border-radius:6px;color:#304a43;font-size:14px;">

                                @if (isAnalyst)
                                {
                                    <text>
                                        • Complete and submit assessment data<br />
                                        • Collaborate with assigned evaluators<br />
                                        • Manage evaluation workflow for assigned pillars
                                    </text>
                                }

                                @if (isEvaluator)
                                {
                                    <text>
                                        • Review submitted assessment inputs<br />
                                        • Provide scores and comments<br />
                                        • Collaborate with analysts on assigned pillars
                                    </text>
                                }

                            </div>

                            <p>
                                If you already have access, simply log in and proceed.
                            </p>

                            <p>
                                For support, contact:
                                <a href="mailto:@Model.Mail" style="color:#304a43;font-weight:600;">
                                    @Model.Mail
                                </a>
                            </p>

                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="background:#FAFAFA;padding:25px 40px;font-size:14px;color:#808080;border-top:1px solid #eee;">
                            <p style="color:#304a43;">Regards,</p>
                            <p style="color:#304a43;font-weight:600;">
                                Grand Event System Administration
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>